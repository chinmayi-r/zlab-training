# Copy to ~/.ai_scientist_secrets, `chmod 600`, fill in, and `source` it.
# NEVER git-add a file with real keys.  This .example file holds no secrets.

# ---- Princeton AI Sandbox ($0 route) -----------------------------------------
# Verified from PrincetonUniversity/hpc_beginning_workshop/ai_sandbox/myscript.py
export USE_AI_SANDBOX=1
export AI_SANDBOX_KEY="PASTE_YOUR_SANDBOX_KEY"
export SANDBOX_ENDPOINT="https://api-ai-sandbox.princeton.edu/"
export SANDBOX_API_VERSION="2025-03-01-preview"
# Available Sandbox model names (use these wherever a model flag/key is needed):
#   o3-mini  gpt-4o-mini  gpt-4o  gpt-35-turbo-16k
#   Meta-Llama-3-1-70B-Instruct-htzs  Meta-Llama-3-1-8B-Instruct-nwxcg  Mistral-small-zgjes
#
# The repo still reads OPENAI_API_KEY when constructing openai clients; after the
# wire_sandbox.py patch the Sandbox branch wins, but set this to a dummy so any
# unpatched code path fails loudly rather than silently calling public OpenAI:
export OPENAI_API_KEY="sk-NOT-USED-sandbox-route"

# ---- Optional ----------------------------------------------------------------
# export S2_API_KEY="..."        # Semantic Scholar; system works without it
# export GEMINI_API_KEY="..."    # if routing through Gemini + GCP $300 credit instead

# ---- Paid fallback only (NOT needed for the Sandbox route) --------------------
# Default experiment model is Bedrock Claude; uncomment these only if you keep it.
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."
# export AWS_REGION_NAME="us-east-1"
